OPENAI_API_KEY=sk-your-key-here

# Posture analyzer backend: mediapipe (free, browser-side) | openai_vision (paid, richer) | hybrid (both)
POSTURE_ANALYZER=mediapipe

# Free at https://unsplash.com/developers - create an app, copy the Access Key.
# Used by the "Describe" image-description practice mode.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# Pronunciation checking backend: azure (default, per-phoneme accuracy) | gpt4o_audio | whisper_fuzzy
PRONUNCIATION_ENGINE=azure

# Free F0 tier at https://portal.azure.com - create a "Speech" resource, copy Key 1 and Region.
# Only needed if PRONUNCIATION_ENGINE=azure.
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=your-azure-region-here
